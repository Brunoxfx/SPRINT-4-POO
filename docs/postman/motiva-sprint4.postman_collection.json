    {
      "name": "24 - Gerar relatorio",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/relatorios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Location presente', function () { pm.expect(pm.response.headers.get('Location')).to.be.a('string').and.not.empty; });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('relatorioId', pm.response.json().relatorio.id); }",
              "if (pm.response.code === 201) {",
              " const json = pm.response.json();",
              " const casos = {trechoUrgenteId:'URGENTE', trechoCriticoId:'CRITICO', trechoAtencaoId:'ATENCAO', trechoNormalId:'NORMAL'};",
              " for (const [key, prioridade] of Object.entries(casos)) { pm.test('Prioridade '+prioridade, function () { const item = json.itens.find(i => String(i.trechoId) === String(pm.collectionVariables.get(key))); pm.expect(item).to.be.an('object'); pm.expect(item.prioridade).to.eql(prioridade); }); }",
              " pm.collectionVariables.set('dataInicio', json.relatorio.dataGeracao.slice(0,10)); pm.collectionVariables.set('dataFim', json.relatorio.dataGeracao.slice(0,10));",
              "}"
            ]
          }
        }
      ]
    },
