      "name": "01 - Criar equipe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/equipes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Equipe Gama\",\n  \"quantidadeIntegrantes\": 5,\n  \"especialidade\": \"Controle preventivo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Location presente', function () { pm.expect(pm.response.headers.get('Location')).to.be.a('string').and.not.empty; });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('equipeId', pm.response.json().id); }"
            ]
          }
        }
      ]
    },
